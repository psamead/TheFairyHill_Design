digraph G {
  graph [fontname="Noto Sans CJK SC", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.9, label="图 1　势力与人物关系（故事 v2.1）", labelloc=t, fontsize=20];
  node [fontname="Noto Sans CJK SC", shape=box, style="rounded,filled", fontsize=13, penwidth=1.2];
  edge [fontname="Noto Sans CJK SC", fontsize=11];
  subgraph cluster_h { label="人间（表世界）"; style="rounded,filled"; fillcolor="#FBF3E2"; color="#C9A24A"; fontsize=14;
    M1 [label="第一代媒介\n（妮芙的祖先）", fillcolor="#F4EDE0"];
    N [label="妮芙 Niamh\n媒介后人 = 「锁」\n（划定边界、分隔两界）", fillcolor="#DDEBD9", color="#2F5D3A"];
    O [label="奥伊芯 Oisín\n「钥匙」（打开两界、让两界相通）\n能力来自 Ogma 的钥匙符文", fillcolor="#F6D9D5", color="#A8322D"];
  }
  subgraph cluster_f { label="妖精丘陵（里世界）"; style="rounded,filled"; fillcolor="#E3EEEC"; color="#1F3D3A"; fontsize=14;
    Q [label="荆棘女王\n目标：两界互不侵犯\n（不知契约细节：Ogma 没能回来禀告）", fillcolor="#FFFFFF"];
    G [label="守门贵族 Ogma（真）\n契约签署者\n千年前回程途中被普卡诱杀", fillcolor="#D9D9D9", style="rounded,filled,dashed"];
    P [label="普卡之首（真正的大 Boss）\n假扮守门贵族\n目标：取代女王、毁掉欧甘文字与契约", fillcolor="#3B3B3B", fontcolor="white"];
    Pm [label="普卡群\n（爪牙 / 眼线）", fillcolor="#6B6B6B", fontcolor="white"];
  }
  F [label="弗魔族 Fomóire\n（达南神族的古老宿敌）", fillcolor="#2A1F3D", fontcolor="white"];
  C [label="欧甘契约法典\nThe Ogham Compact\n（圣物：用欧甘字母写成）", shape=note, fillcolor="#F2E3B3", color="#C9A24A", fontsize=14];

  M1 -> C [label="提供文字、交换名字签约"];
  G -> C [label="交换名字签约"];
  G -> M1 [label="赠圣物铁十字（信任传递 + 保险）", color="#4A5A6A"];
  M1 -> N [label="血脉、家传银冠、家传铁十字"];
  N -> O [label="挚友；两人各持半颗心形扣", dir=both, color="#C9A24A"];
  P -> G [label="诱杀并假扮千年", color="#A8322D"];
  P -> F [label="千年前暗中投靠，接受其力量\n（因此和弗魔族一样惧怕铁十字）", style=dashed];
  Q -> G [label="赐圣物铁十字（信任）", color="#4A5A6A"];
  P -> Pm [label="指挥"];
  P -> C [label="憎恨：文字定义了他的「恶」", color="#A8322D", style=dashed];
  Q -> O [label="召唤并「款待」：\n把钥匙留在里世界", color="#1F3D3A"];
  P -> O [label="黄昏打开古墓引诱：\n要用钥匙打开两界", color="#A8322D"];
  P -> N [label="名字交易：\n夺走媒介的名字", color="#A8322D", style=dashed];
  G -> O [label="死后钥匙一半化为符文，\n千年后选中她", style=dashed, color="#C9A24A"];
  Q -> P [label="不知其身份", style=dotted, dir=none];
}
